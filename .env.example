# Local development values only — not for production.
# Copy to .env (`cp .env.example .env`) and run `docker compose up -d`:
# compose.yaml reads MONGO_USER/MONGO_PASSWORD, the backend reads MONGODB_URI.
MONGO_USER=easygenerator
MONGO_PASSWORD=easygenerator-dev-pass
MONGODB_URI=mongodb://easygenerator:easygenerator-dev-pass@localhost:27017/easygenerator?authSource=admin
