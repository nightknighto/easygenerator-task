# Local development values only — not for production.
# Copy to .env (`cp .env.example .env`) and run `docker compose up -d`:
# compose.yaml reads MONGO_USER/MONGO_PASSWORD, the backend reads MONGODB_URI.
MONGO_USER=easygenerator
MONGO_PASSWORD=easygenerator-dev-pass
MONGODB_URI=mongodb://easygenerator:easygenerator-dev-pass@localhost:27017/easygenerator?authSource=admin

# Auth module (dev-only values).
# SMTP: mailpit in compose.yaml catches all mail on localhost:1025 (UI: http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Easygenerator Task <no-reply@localhost>"
# Signup emails link back to the Vite dev server.
FRONTEND_URL=http://localhost:5173
# Dev-only secret — MUST be replaced with a strong random value in production.
ACCESS_TOKEN_SECRET=dev-only-access-token-secret-change-me

# Backend port the Vite dev proxy targets (default 3000; 3100 on this dev machine).
# BACKEND_PORT=3100
